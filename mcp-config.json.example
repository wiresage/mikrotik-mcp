{
  "mcpServers": {
    "mikrotik-mcp-server": {
      "command": "uvx",
      "args": ["mcp-server-mikrotik"],
      "env": {
        "MIKROTIK_HOST": "192.168.88.1",
        "MIKROTIK_USERNAME": "admin",
        "MIKROTIK_PASSWORD": "your_password",
        "MIKROTIK_PORT": "22"
      }
    }
  }
}
